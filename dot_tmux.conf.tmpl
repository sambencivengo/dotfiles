unbind r
bind r source-file "$HOME/.tmux.conf"

# set -g @plugin 'rose-pine/tmux'
# set -g @rose_pine_variant 'main' # Options are 'main', 'moon' or 'dawn'
# set -g @rose_pine_disable_active_window_menu 'on' # Disables the menu that shows the active window on the left
# set -g @rose_pine_directory 'on' # Turn on the current folder component in the status bar
#set -g @plugin 'Nybkox/tmux-kanagawa'
#set -g @kanagawa-theme 'dragon'


set -g @kanagawa-ignore-window-colors false
#set -g window-style 'bg=#333131,fg=default'
#set -g window-active-style 'bg=#171616,fg=default'
set -g pane-border-lines heavy

set -g pane-active-border-style fg=cyan
set -g default-terminal "tmux-256color"
set -as terminal-overrides ",*:Tc"

# Status bar on bottom, with some padding
set -g status-position bottom
set -g status-interval 0
set -g status-justify left
set -g status-left-length 100
set -g status-right-length 0

# Remove right side info
set -g status-right ""

# Style
set -g status-style bg=default,fg=default

# Left side (session name with padding)
set -g status-left " #[bold]#S: "

# Inactive windows (with spacing)
setw -g window-status-format "  #I:#W  "

# Active (current) window — yellowish orange highlight
 setw -g window-status-current-format " [#[fg=color1,bg=default,bold]#I:#W#[default]] "

# Zoom in status
set -g status-right '#{?window_zoomed_flag,#[fg=colour1] ZOOM #[default],}'


setw -g mode-keys vi
set -g xterm-keys on
set -g @kanagawa-plugins "git network"
set -g @kanagawa-show-powerline true
set -g @kanagawa-border-contrast true

set -g mouse on

bind-key h select-pane -L
bind-key j select-pane -D
bind-key k select-pane -U
bind-key l select-pane -R

# Resize panes (Option/Alt + hjkl)
bind -n M-h resize-pane -L 3
bind -n M-l resize-pane -R 3
bind -n M-j resize-pane -D 1
bind -n M-k resize-pane -U 1

# Split vertically with |
bind | split-window -h

# Split horizontally with =
bind = split-window -v


set -g base-index 1
set -g pane-base-index 1

# List of plugins
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'

set-option -ga terminal-overrides ",xterm-256color:Tc"



# Other examples:
# set -g @plugin 'github_username/plugin_name'
# set -g @plugin 'github_username/plugin_name#branch'
# set -g @plugin 'git@github.com:user/plugin'
# set -g @plugin 'git@bitbucket.com:user/plugin'

# Initialize TMUX plugin manager (keep this line at the very bottom of tmux.conf)



{{ if eq .chezmoi.os "darwin" -}}
# Mac
set -g prefix C-Space
bind C-Space send-prefix
set -g status-position top
{{- else -}}
# Server
set -g prefix C-a
unbind C-b
bind C-a send-prefix
set -g status-position bottom
set -g pane-active-border-style fg=colour208
set -g status-left " #[fg=colour208,bold]#H#[default] #[bold]#S: "
{{- end }}


run '~/.tmux/plugins/tpm/tpm'












